node_modules/
dist/
.DS_Store

# Claude-Code-Arbeitskopien. Das sind eigenstaendige Git-Repositories; ohne
# diese Zeile landen sie beim "git add -A" als Submodul-Verweise im Commit
# (Modus 160000). Sie zeigen dann auf Objekte, die es auf GitHub nicht gibt,
# und ein frischer Klon bricht beim Auschecken ab.
.claude/worktrees/
.claude/settings.local.json
*.local
.env
.env.*
.vercel
.env*.local

# Local raw image working library — never deploy/commit (originals + customer photos)
raw-image-library/

# Rohbild-Archiv. Lag bis 08/2026 als assets-archiv/ im Repo und hat 172 MB in
# die Historie geschrieben. Liegt jetzt daneben unter
# ../waxcelerate-assets-archiv/. Diese Zeile verhindert, dass es zurueckwandert.
assets-archiv/

# Messartefakte des Performance-Audits: Screenshots und Lighthouse-Laeufe, rund
# 84 MB, jederzeit mit run-audit.sh neu erzeugbar. Bericht und Skript bleiben
# dagegen versioniert — docs/plaene/MOBILE_PLAN.md steht komplett auf diesem
# Bericht, und index.html verweist darauf. Gleiches Muster wie bei den
# Blogbildern weiter oben: Ordner ignorieren, das Wenige davon ausnehmen.
performance-audit/*
!performance-audit/AUDIT_REPORT.md
!performance-audit/run-audit.sh

# public/images/blog: only ship the optimized derivatives the code actually
# references (see scripts/optimize-blog-images.mjs) + manifest.json. Raw
# camera originals (multi-MB each) and unrelated personal photos that end up
# in this working folder must never enter git history.
public/images/blog/*
!public/images/blog/*-1600.webp
!public/images/blog/*-800.webp
!public/images/blog/*-1600.jpg
!public/images/blog/*-800.jpg
!public/images/blog/manifest.json
image-drop/
