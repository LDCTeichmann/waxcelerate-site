node_modules/
dist/
.DS_Store

# Claude-Code-Arbeitskopien. Das sind eigenstaendige Git-Repositories; ohne
# diese Zeile landen sie beim "git add -A" als Submodul-Verweise im Commit
# (Modus 160000). Sie zeigen dann auf Objekte, die es auf GitHub nicht gibt,
# und ein frischer Klon bricht beim Auschecken ab.
.claude/worktrees/
.claude/settings.local.json
*.local
.env
.env.*
.vercel
.env*.local

# Local raw image working library — never deploy/commit (originals + customer photos)
raw-image-library/

# public/images/blog: only ship the optimized derivatives the code actually
# references (see scripts/optimize-blog-images.mjs) + manifest.json. Raw
# camera originals (multi-MB each) and unrelated personal photos that end up
# in this working folder must never enter git history.
public/images/blog/*
!public/images/blog/*-1600.webp
!public/images/blog/*-800.webp
!public/images/blog/*-1600.jpg
!public/images/blog/*-800.jpg
!public/images/blog/manifest.json
