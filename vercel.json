{
  "redirects": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "www.waxcelerate.de" }],
      "destination": "https://waxcelerate.de/$1",
      "permanent": true
    }
  ],
  "rewrites": [{ "source": "/((?!api/|google46acc6bf86fe233d\\.html).*)", "destination": "/index.html" }],
  "headers": [
    {
      "//": "Interne und transaktionale Routen aus dem Index halten. Sie liefern die SPA-Huelle aus und trugen dadurch das globale 'index, follow' aus index.html: /admin ist die Lagerverwaltung, /hero-lab ein Entwurfsvergleich, /bestellung-erfolgreich existiert nur nach einem Kauf und /produkt/*/stage ist eine Darstellungsvariante ohne eigenen Inhalt. Als HTTP-Header statt Meta-Tag, weil react-helmet erst nach dem Start von React greift und Crawler ohne JavaScript nie so weit kommen.",
      "source": "/(admin|hero-lab|bestellung-erfolgreich)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
      ]
    },
    {
      "source": "/produkt/(.*)/stage",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/images/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "X-XSS-Protection", "value": "1; mode=block" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    }
  ]
}
